name: Build Kryvex Client

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Extract source
        run: |
          echo "--- Проверяем файлы в репозитории ---"
          ls -la
          echo "--- Распаковываем ---"
          mkdir source
          unzip -o Kryvex-1.21.4-source.zip -d source

      - name: Find project
        run: |
          FILE=$(find source -type f \( -name "build.gradle" -o -name "build.gradle.kts" \) | head -n 1)
          if [ -z "$FILE" ]; then
            echo "Error: build.gradle not found!"
            exit 1
          fi
          echo "PROJECT_DIR=$(dirname "$FILE")" >> $GITHUB_ENV

      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Fix Gradle repositories
        run: |
          python3 - <<'PY'
          import os
          from pathlib import Path
          
          base_dir = os.environ.get("PROJECT_DIR", "source")
          for name in ("settings.gradle", "settings.gradle.kts"):
              for p in Path(base_dir).rglob(name):
                  s = p.read_text()
                  s = s.replace("RepositoriesMode.FAIL_ON_PROJECT_REPOS", "RepositoriesMode.PREFER_SETTINGS")
                  p.write_text(s)
          PY

      - name: Build
        run: |
          cd "$PROJECT_DIR"
          if [ -f gradlew ]; then
            chmod +x gradlew
            ./gradlew build
          else
            gradle build
          fi

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: my-app-jar
          path: ${{ env.PROJECT_DIR }}/build/libs/*.jar
